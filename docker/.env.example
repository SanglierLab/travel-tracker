# Copier vers docker/.env (non versionné).

# Dossier racine du projet sur le NAS. Il doit contenir : config/application.yml et media/
TT_BASE_DIR=/volume1/docker/travel-tracker

# UID/GID de l'utilisateur du NAS propriétaire de ${TT_BASE_DIR}/media  (commande : id <utilisateur>)
# Port du NAS sur lequel HAProxy joint l'application (le port interne reste 18081)
WEB_PORT=18081

PUID=1026
PGID=100
